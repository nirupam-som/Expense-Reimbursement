# Copy to .env and adjust. Never commit .env.

# Matches docker-compose.yml. In production this is the managed Postgres URL.
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_reimbursement

# Signing key for JWTs. Generate a real one for anything deployed:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-do-not-use-in-production
JWT_EXPIRES_MINUTES=1440

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Goal 10 — stale-approval alert thresholds.
# A Submitted report with no decision after STALE_AFTER_DAYS raises an alert.
# A dismissed alert reappears STALE_REALERT_AFTER_DAYS after it was dismissed,
# if the report is still undecided.
STALE_AFTER_DAYS=5
STALE_REALERT_AFTER_DAYS=3
